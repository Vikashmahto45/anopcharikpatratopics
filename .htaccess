<IfModule mod_rewrite.c>
    RewriteEngine On

    # HUB 1 REDIRECTS (Grammar & Rules)
    RewriteRule ^anopcharik-patra-format\.php$ /anopcharik-patra-grammar-rules.php [R=301,L]
    RewriteRule ^anopcharik-patra-ka-prarup\.php$ /anopcharik-patra-grammar-rules.php [R=301,L]
    RewriteRule ^what-is-the-format-of-anopcharik-patra-in-hindi\.php$ /anopcharik-patra-grammar-rules.php [R=301,L]
    RewriteRule ^anopcharik-patra-lekhan-kise-kahate-hain\.php$ /anopcharik-patra-grammar-rules.php [R=301,L]
    RewriteRule ^anopcharik-patra-lekhan\.php$ /anopcharik-patra-grammar-rules.php [R=301,L]
    RewriteRule ^anopcharik-patra-wikipedia\.php$ /anopcharik-patra-grammar-rules.php [R=301,L]
    RewriteRule ^anopcharik-patra\.php$ /anopcharik-patra-grammar-rules.php [R=301,L]
    RewriteRule ^aupcharik-aur-anopcharik-patra\.php$ /anopcharik-patra-grammar-rules.php [R=301,L]
    RewriteRule ^anopcharik-patra-hindi\.php$ /anopcharik-patra-grammar-rules.php [R=301,L]
    RewriteRule ^anopcharik-patra-bank-manager-ko\.php$ /anopcharik-patra-grammar-rules.php [R=301,L]
    RewriteRule ^anopcharik-patra-bus-conductor\.php$ /anopcharik-patra-grammar-rules.php [R=301,L]
    RewriteRule ^kachra-prabandhan-par-anopcharik-patra\.php$ /anopcharik-patra-grammar-rules.php [R=301,L]
    RewriteRule ^short-anopcharik-patra\.php$ /anopcharik-patra-grammar-rules.php [R=301,L]

    # HUB 2 REDIRECTS (Class 9-10)
    RewriteRule ^10-anopcharik-patra-in-hindi-for-class-9\.php$ /anopcharik-patra-class-9-10.php [R=301,L]
    RewriteRule ^2-anopcharik-patra-in-hindi\.php$ /anopcharik-patra-class-9-10.php [R=301,L]
    RewriteRule ^3-anopcharik-patra-in-hindi\.php$ /anopcharik-patra-class-9-10.php [R=301,L]
    RewriteRule ^5-anopcharik-patra-in-hindi\.php$ /anopcharik-patra-class-9-10.php [R=301,L]
    RewriteRule ^anopcharik-patra-class-10th\.php$ /anopcharik-patra-class-9-10.php [R=301,L]
    RewriteRule ^anopcharik-patra-class-9\.php$ /anopcharik-patra-class-9-10.php [R=301,L]
    RewriteRule ^anopcharik-patra-format-class-9\.php$ /anopcharik-patra-class-9-10.php [R=301,L]
    RewriteRule ^anopcharik-patra-questions\.php$ /anopcharik-patra-class-9-10.php [R=301,L]
    RewriteRule ^class-5-hindi-anopcharik-patra-topic\.php$ /anopcharik-patra-class-9-10.php [R=301,L]
    RewriteRule ^do-anopcharik-patra\.php$ /anopcharik-patra-class-9-10.php [R=301,L]

    # HUB 3 REDIRECTS (Class 12 & Advanced)
    RewriteRule ^anopcharik-patra-example\.php$ /anopcharik-patra-class-12.php [R=301,L]
    RewriteRule ^anopcharik-patra-in-hindi\.php$ /anopcharik-patra-class-12.php [R=301,L]
    RewriteRule ^anopcharik-patra-in-marathi\.php$ /anopcharik-patra-class-12.php [R=301,L]
    RewriteRule ^anopcharik-patra-in-sanskrit\.php$ /anopcharik-patra-class-12.php [R=301,L]
    RewriteRule ^anopcharik-patra-topics-in-hindi\.php$ /anopcharik-patra-class-12.php [R=301,L]
    RewriteRule ^best-anopcharik-patra-in-hindi\.php$ /anopcharik-patra-class-12.php [R=301,L]
    RewriteRule ^hindi-me-anopcharik-patra\.php$ /anopcharik-patra-class-12.php [R=301,L]

    # HUB 4 REDIRECTS (Family & Friends)
    RewriteRule ^anopcharik-patra-to-friend\.php$ /anopcharik-patra-family-friends.php [R=301,L]
    RewriteRule ^apne-mummy-ko-anopcharik-patra\.php$ /anopcharik-patra-family-friends.php [R=301,L]
    RewriteRule ^anopcharik-patra-madhur-smrutiya\.php$ /anopcharik-patra-family-friends.php [R=301,L]

    # Do NOT redirect if the requested file actually exists 
    RewriteCond %{REQUEST_FILENAME} !-f
    # Do NOT redirect if the requested directory actually exists
    RewriteCond %{REQUEST_FILENAME} !-d

    # Catch-all for any other missing pages
    RewriteRule ^(.*)$ / [R=301,L]
</IfModule>

# Prevent directory browsing for security
Options -Indexes